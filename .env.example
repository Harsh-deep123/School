# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# API_PORT: Express college ERP API (default 3001)
API_PORT=3001

# MySQL connection (all college ERP data)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=ait_college_erp

# Super Admin (optional overrides)
SUPER_ADMIN_USER=superadmin
SUPER_ADMIN_PASS=ait@admin
SUPER_ADMIN_TOKEN=ait-super-admin-token
